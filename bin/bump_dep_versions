#!/usr/bin/env ruby

require 'bundler/setup'
require 'thor'

class VersionUpdater < Thor::Group
  include Thor::Actions

  class_option :node, type: :string, desc: 'New Rolemodel::NODE_VERSION (e.g. 24.12.0)'
  class_option :ruby, type: :string, desc: 'New Rolemodel::RUBY_VERSION (e.g. 4.0.1)'

  source_root File.expand_path('../', __FILE__)

  def verify_an_option_was_given
    return if options.node? || options.ruby?

    say 'Nothing to update!', :red
    raise Thor::InvocationError, 'Pass --node VERSION and/or --ruby VERSION.'
  end

  def update_node_version
    return unless options.node?

    say "Updating Rolemodel::NODE_VERSION to #{set_color(options.node, :yellow)}", :green
    gsub_file 'lib/rolemodel-rails.rb', /^  NODE_VERSION = .*/, "  NODE_VERSION = '#{options.node}'"

    # example_rails_current tracks NODE_VERSION so generator specs run against
    # the same Node the gem itself will pin generated apps to. example_rails_legacy
    # is intentionally pinned to older versions and must not be touched.
    create_file 'example_rails_current/.node-version', options.node, force: true
  end

  def update_ruby_version
    return unless options.ruby?

    say "Updating Rolemodel::RUBY_VERSION to #{set_color(options.ruby, :yellow)}", :green
    gsub_file 'lib/rolemodel-rails.rb', /^  RUBY_VERSION = .*/, "  RUBY_VERSION = '#{options.ruby}'"

    create_file 'example_rails_current/.ruby-version', options.ruby, force: true
  end

  class << self
    def exit_on_failure? = true
    def banner = 'bin/update_versions [--node VERSION] [--ruby VERSION]'
    def desc = 'Update Rolemodel::NODE_VERSION / Rolemodel::RUBY_VERSION and sync example_rails_current'
  end
end

VersionUpdater.start(ARGV) if __FILE__ == $PROGRAM_NAME
