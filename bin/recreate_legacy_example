#!/usr/bin/env bash
RAILS_VERSION='7.2.2.1'
APP_PATH='example_rails_legacy'

set -euo pipefail
IFS=$'\n\t'
set -vx

if ! gem list rails -i -v $RAILS_VERSION --silent; then
  gem install rails -v $RAILS_VERSION
fi

rm -fr ${APP_PATH}

rails _"$RAILS_VERSION"_ new --skip-keeps --skip-git --skip-jbuilder -j webpack -d postgresql ${APP_PATH}

cp -f templates/dummy_app/config/boot.rb.tt ${APP_PATH}/config/boot.rb
cd ${APP_PATH}

bundle install

rm config/credentials.yml.enc
rm config/master.key

cd -
