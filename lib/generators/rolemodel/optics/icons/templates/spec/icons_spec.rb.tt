# frozen_string_literal: true

require 'rails_helper'
require 'rolemodel/optics'

# Icons render from SVG files in the repo. This fails when a view names an icon that is not vendored.
# Names built at runtime are not found here; vendor those by hand.
RSpec.describe 'Vendored icons' do
  it 'has an SVG for every icon the app uses' do
    missing = Rolemodel::Optics::Hugeicons.missing.map { |name, style| "#{style}/#{name}" }

    expect(missing).to be_empty, <<~MESSAGE
      Missing icons: #{missing.join(', ')}
      Run: HUGEICONS_API_KEY=... bin/rails optics:icons:vendor ICONS=#{missing.join(',')}
    MESSAGE
  end
end
