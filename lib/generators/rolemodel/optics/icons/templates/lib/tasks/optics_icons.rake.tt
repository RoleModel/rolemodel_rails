# frozen_string_literal: true

require 'rolemodel/optics'

namespace :optics do
  namespace :icons do
    desc 'Vendor Hugeicons SVGs. ICONS=name,style/name, or every icon the app uses but lacks. Needs HUGEICONS_API_KEY.'
    task vendor: :environment do
      hugeicons = Rolemodel::Optics::Hugeicons
      icons = ENV['ICONS'].present? ? hugeicons.parse(ENV['ICONS']) : hugeicons.missing
      abort 'Every Hugeicon the app uses is already vendored.' if icons.empty?

      hugeicons.vendor(icons)
    rescue Rolemodel::Optics::Hugeicons::Error, ArgumentError => e
      abort e.message
    end
  end
end
